# Environment for the LOCAL/CI Supabase stack — committed on purpose.
#
# Every value here is a well-known local-dev constant, identical on every
# machine that runs `supabase start`. None of it is a secret: the publishable
# key ships to the browser anyway and RLS is what protects the data. Real
# secrets (VAPID, anything production) live in .env.local, which is gitignored.
#
# This file exists so CI's environment is not hand-maintained inside the
# workflow YAML. It used to be, and it drifted: when e2e sign-in switched to
# minting its own link with the service role, the workflow's inline heredoc
# never gained SUPABASE_SERVICE_ROLE_KEY, and CI failed on every push for days
# with eleven specs dying in a way that looked like an app regression. One
# source of truth, checked in, diffable.
#
# SUPABASE_SERVICE_ROLE_KEY is deliberately NOT here — CI appends it by reading
# the running stack, so a CLI credential rotation cannot rot a pasted copy.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Auth flows the e2e suite exercises. Both are NEXT_PUBLIC_*, so they are
# inlined at BUILD time — setting them only for the test process looks
# identical to not setting them at all. Production sets neither.
NEXT_PUBLIC_AUTH_EMAIL=1
NEXT_PUBLIC_AUTH_DEV=1

# A throwaway VAPID PUBLIC key, generated for CI and used nowhere else. A public
# key is not a secret (it is handed to the browser's push service by design) and
# the matching private key exists nowhere, so nothing can be sent with it.
#
# It has to be here because the profile screen now BRANCHES on it: no key means
# "reminders aren't configured on the server", which is the honest thing to tell
# a member but not the state CI should test. Without it the iOS install-coaching
# spec sees the unconfigured card instead — which is exactly how this file drifted
# the first time, so: any new env-gated behaviour lands here AND in check-env.mjs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEszaqAeIWVaAs98wTpPY32EQMI76gFe4koH61Q13w_tPHV0VqzG5HAYaZ9XZvOvaKRRGeSD3-YzvTKLTmOSjSI
